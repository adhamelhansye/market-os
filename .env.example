# ------------------------------------------------------------------
# MarketingOS development environment
# Copy to .env and adjust as needed. Never commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL (used by docker-compose services)
POSTGRES_USER=marketingos
POSTGRES_PASSWORD=marketingos_dev
POSTGRES_DB=marketingos

# Backend
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://marketingos:marketingos_dev@postgres:5432/marketingos
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
ENCRYPTION_KEY=change-me-encryption-key
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Shopify OAuth (create an app at https://partners.shopify.com → Apps)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/integrations/shopify/callback

# Meta Ads OAuth (create an app at https://developers.facebook.com → App Review
# requires Advanced Access for ads_read; META_APP_SECRET is server-side only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/meta/callback
META_GRAPH_API_VERSION=v26.0
META_SCOPES=ads_read
META_INITIAL_SYNC_DAYS=90
META_INCREMENTAL_LOOKBACK_DAYS=2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Tests (run against localhost when using the local test database)
TEST_DATABASE_URL=postgresql+asyncpg://marketingos:marketingos_dev@localhost:5432/marketingos_test
TEST_REDIS_URL=redis://localhost:6379/15